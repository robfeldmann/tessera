[codespell]
skip = .git,.build,.venv,node_modules,Packages,Sources/**/*.docc/Resources
ignore-words-list = inout,ratatui,iterm,theses
# Wireframes and styled grids cut words on purpose (`warnin`, `tha…`) and use letter runs
# as style codes; the legend that follows a styled grid is still checked.
ignore-multiline-regex = ```wireframe.*?```|── chars ──.*?── legend ──
