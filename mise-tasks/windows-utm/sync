#!/usr/bin/env bash
#MISE description="Push the current branch into the UTM Windows guest checkout over SSH"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
host="${TESSERA_WINDOWS_VM_SSH:-}"
if [[ -z "$host" ]]; then
  echo "⚠️  TESSERA_WINDOWS_VM_SSH is not set" >&2
  echo "Set it to your Windows VM SSH target; see docs/guides/windows-vm.md." >&2
  exit 1
fi
repo="${TESSERA_WINDOWS_VM_REPO:-tessera}"
branch="$(git rev-parse --abbrev-ref HEAD)"
if ! ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "cd $repo && git --version" > /dev/null 2>&1; then
  echo "⚠️  Cannot reach the guest repo '$repo' on '$host'." >&2
  echo "Check the VM is running and 'mise run windows-utm:check' succeeds." >&2
  exit 1
fi
ssh "$host" "cd $repo && git config receive.denyCurrentBranch updateInstead"
echo "Pushing $branch to $host:$repo ..."
git push --force-with-lease "$host:$repo" "HEAD:$branch"
ssh "$host" "cd $repo && git log -1 --oneline && git status -sb"
