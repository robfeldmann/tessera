#!/usr/bin/env bash
#MISE description="Build and test on Windows, honoring TESSERA_CI_WINDOWS_TEST_FILTER"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
swift build
if [[ -n "${TESSERA_CI_WINDOWS_TEST_FILTER:-}" ]]; then
  swift test --no-parallel --filter "$TESSERA_CI_WINDOWS_TEST_FILTER"
else
  swift test --no-parallel
fi
