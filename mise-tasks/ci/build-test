#!/usr/bin/env bash
#MISE description="Build and test the package, build the Examples, test them, and run the scenario corpus"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
swift build --only-use-versions-from-resolved-file
swift build --only-use-versions-from-resolved-file --package-path Examples
swift test --only-use-versions-from-resolved-file --no-parallel
swift test --only-use-versions-from-resolved-file --no-parallel --package-path Examples
swift run --only-use-versions-from-resolved-file --package-path Examples tessera run --pretty Examples/Scenarios
