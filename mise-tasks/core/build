#!/usr/bin/env bash
#MISE description="Build the Swift package"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
# --only-use-versions-from-resolved-file: Swift 6.3 would otherwise rewrite the Swift 6.4
# Package.resolved (docs/architecture/toolchain-lanes.md).
swift build --only-use-versions-from-resolved-file "$@"
