#!/usr/bin/env bash
#MISE description="Check one app against the invariant rules (tessera check NAME); not yet available"
#USAGE arg "<name>" help="App name, as listed by `mise run dev:apps`"
#USAGE arg "[size]" help="desktop, mobile, mobileScreen, or WxH; desktop when omitted"
#USAGE flag "--json" help="Print one JSON object even on a terminal"
#USAGE flag "--pretty" help="Print the text form even when output is not a terminal"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
swift run --only-use-versions-from-resolved-file --package-path Examples tessera check "$@"
