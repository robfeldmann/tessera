# Layers share their bounds whatever the viewport: the ZStack takes the largest child, 4x2 for
# the block of A's, and the `priority` sample's two layers sit on one frame because a ZStack
# ignores layout priority.
app zstack
size mobile

expect node type=ZStack nth=2 frame 20,3,4x2
expect node type=ZStack nth=4 frame 7,7,1x1
expect text 3 "OKatus   Go······   bbAA"
check
shot mobile

# The last alignment puts `Go` in the corner: the last two cells of the last backdrop row.
type "aaaaaaaa"
expect node type=Text text="Go" frame 15,5,2x1
shot alignment-bottom-trailing
