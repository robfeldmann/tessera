# `size mobile` is 40 columns at the natural height the driver measures from the graph.
app stack
size mobile

expect node id=root frame 0,0,40x6
expect text 0 "Stack demo"
expect text 2 "Name: -"
expect text 3 "left                               right"
expect text 5 "40 columns"
type "Rob"
expect text 2 "Name: Rob"
resize 60x8
expect text 5 "60 columns"
expect node type=Spacer frame 4,3,51x0
shot mobile
