index 0000000..9dbb096
--- /dev/null
+++ b/Tests/TesseraCoreTests/ViewGraphClockTests.swift
@@ -0,0 +1,59 @@
+import TesseraTerminalCore
+import TesseraTestSupport
+import Testing
+
+@testable import TesseraCore
+
+@Test
+func `injected clock supplies every graph pass duration`() {
+  let size = TerminalSize(columns: 4, rows: 1)
+  let origin = ContinuousClock.now
+  var readings = 0
+  let graph = ViewGraph(
+    root: { Text("tick") },
+    size: size,
+    now: {
+      readings += 1
+      return origin.advanced(by: .milliseconds(10 * readings))
+    }
+  )
+
+  graph.update()
+  expectDurations(graph.statistics, update: .milliseconds(10), layout: .zero, render: .zero)
+
+  _ = withTestFrame(size: size) { graph.render(into: $0) }
+  expectDurations(
+    graph.statistics,
+    update: .milliseconds(10),
+    layout: .milliseconds(10),
+    render: .milliseconds(10)
+  )
+}
+
+@Test
+func `graphs sharing deterministic clocks produce equal diagnostics`() {
+  let size = TerminalSize(columns: 4, rows: 1)
+  let origin = ContinuousClock.now
+  func makeGraph() -> ViewGraph {
+    ViewGraph(root: { Text("same") }, size: size, now: { origin })
+  }
+  let first = makeGraph()
+  let second = makeGraph()
+
+  _ = withTestFrame(size: size) { first.render(into: $0) }
+  _ = withTestFrame(size: size) { second.render(into: $0) }
+
+  #expect(first.diagnostics == second.diagnostics)
+  #expect(first.diagnostics.statistics.renderDuration == .zero)
+}
+
+private func expectDurations(
+  _ statistics: GraphStatistics,
+  update: Duration,
+  layout: Duration,
+  render: Duration
+) {
+  #expect(statistics.updateDuration == update)
+  #expect(statistics.layoutDuration == layout)
+  #expect(statistics.renderDuration == render)
+}
diff --git a/Tests/TesseraTerminalTests/TerminalSessionSeamTests.swift b/Tests/TesseraTerminalTests/TerminalSessionSeamTests.swift
new file mode 100644
index 0000000..41a8186
--- /dev/null
+++ b/Tests/TesseraTerminalTests/TerminalSessionSeamTests.swift
@@ -0,0 +1,130 @@
+import TesseraTerminalANSI
+import TesseraTerminalCore
+import TesseraTerminalInput
+import TesseraTerminalTestSupport
+import Testing
+
+@testable import TesseraTerminal
+@testable import TesseraTerminalIO
+
+@Test
+func `resize delivered mid-session produces a second draw at the new size`() async throws {
+  let initialSize = TerminalSize(columns: 4, rows: 2)
+  let resizedSize = TerminalSize(columns: 6, rows: 3)
+  let device = InMemoryTerminalDevice(
+    size: initialSize,
+    cellPixelSize: nil,
+    inputBytes: [],
+    keepsInputOpen: true
+  )
+  let session = InMemoryTerminalSession(device: device)
+  var drawnSizes: [TerminalSize] = []
+  var receivedEvent: InputEvent?
+  var receivedSizeChange: TerminalSize?
+
+  try await session.withApplicationTerminal { terminal in
+    var sizeChanges = terminal.sizeChanges.makeAsyncIterator()
+    drawnSizes.append(
+      try await terminal.draw { frame in
+        frame.write("a", at: TerminalPosition(column: 0, row: 0))
+        return frame.size
+      }
+    )
+
+    await device.deliverResize(to: resizedSize)
+    receivedEvent = try await terminal.nextEvent()
+    receivedSizeChange = await sizeChanges.next()
+
+    drawnSizes.append(
+      try await terminal.draw { frame in
+        frame.write("b", at: TerminalPosition(column: 5, row: 2))
+        return frame.size
+      }
+    )
+    await device.closeInput()
+  }
+
+  #expect(drawnSizes == [initialSize, resizedSize])
+  #expect(receivedEvent == .resize(resizedSize))
+  #expect(receivedSizeChange == resizedSize)
+  #expect(await device.events.filter(\.isFlush).count >= 2)
+}
+
+@Test
+func `closed input ends the event stream of an open device`() async throws {
+  let device = InMemoryTerminalDevice(
+    size: TerminalSize(columns: 4, rows: 2),
+    cellPixelSize: nil,
+    inputBytes: [],
+    keepsInputOpen: true
+  )
+  let session = InMemoryTerminalSession(device: device)
+
+  await #expect(throws: PlatformIOError.inputClosed) {
+    try await session.withApplicationTerminal { terminal in
+      await device.closeInput()
+      _ = try await terminal.nextEvent()
+    }
+  }
+}
+
+@Test
+func `injected probe image ID reaches the active Kitty graphics query`() async throws {
+  let device = DeviceAttributesTerminalDevice()
+  let io = PlatformIO(terminalDevice: await device.terminalDevice)
+  let configuration = TerminalApplicationConfiguration(
+    activeProbeTimeout: .milliseconds(100),
+    capabilityDetection: .active
+  )
+
+  try await TerminalSession.withApplicationTerminal(
+    configuration: configuration,
+    io: io,
+    environment: [:],
+    probeImageID: KittyImageID(rawValue: 4_242)
+  ) { _ in }
+
+  let queries = await device.flushes.map { String(decoding: $0, as: UTF8.self) }
+  #expect(queries.contains { $0.hasPrefix("\u{1B}_Gi=4242,") })
+}
+
+/// Answers every probe round that ends in a primary device attributes query.
+private actor DeviceAttributesTerminalDevice {
+  private let inputContinuation: AsyncStream<[UInt8]>.Continuation
+  private let inputStream: AsyncStream<[UInt8]>
+
+  private(set) var flushes: [[UInt8]] = []
+
+  var terminalDevice: TerminalDevice {
+    let inputStream = inputStream
+    return TerminalDevice(
+      bytes: { inputStream },
+      size: { TerminalSize(columns: 4, rows: 2) },
+      write: { await self.write($0) }
+    )
+  }
+
+  init() {
+    let stream = AsyncStream<[UInt8]>.makeStream()
+    self.inputContinuation = stream.continuation
+    self.inputStream = stream.stream
+  }
+
+  private func write(_ byteSlice: ArraySlice<UInt8>) -> Int {
+    let bytes = Array(byteSlice)
+    flushes.append(bytes)
+    if bytes.suffix(3) == [0x1B, 0x5B, 0x63] {
+      inputContinuation.yield(Array("\u{1B}[?1;2c".utf8))
+    }
+    return bytes.count
+  }
+}
+
+extension InMemoryTerminalDeviceEvent {
+  fileprivate var isFlush: Bool {
+    if case .flush = self {
+      return true
+    }
+    return false
+  }
+}
